rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidInsulinEntry() {
      let data = request.resource.data;

      return data.keys().hasAll([
            'insulinName',
            'kind',
            'doseUnits',
            'administeredAt',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'insulinName',
            'kind',
            'doseUnits',
            'administeredAt',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && data.insulinName is string
          && data.insulinName.size() > 0
          && data.insulinName.size() <= 100
          && data.kind in ['bolus', 'basal', 'other']
          && data.doseUnits is number
          && data.doseUnits > 0
          && data.administeredAt is timestamp
          && data.administeredAt <= request.time
          && data.note is string
          && data.note.size() <= 1000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /users/{userId}/insulin_entries/{entryId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && isValidInsulinEntry()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
          && isValidInsulinEntry()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    function isOwner(userId) {
      return request.auth != null
          && request.auth.uid == userId;
    }

    function isValidReading() {
      let data = request.resource.data;

      return data.keys().hasAll([
            'valueMgDl',
            'type',
            'measuredAt',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'valueMgDl',
            'type',
            'measuredAt',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && data.valueMgDl is int
          && data.valueMgDl > 0
          && data.type in ['fasting', 'postMeal']
          && data.measuredAt is timestamp
          && data.note is string
          && data.note.size() <= 1000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function isValidHba1cResult() {
      let data = request.resource.data;

      return data.keys().hasAll([
            'valuePercent',
            'testDate',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'valuePercent',
            'testDate',
            'note',
            'createdAt',
            'updatedAt'
          ])
          && (data.valuePercent is int || data.valuePercent is float)
          && data.valuePercent > 0
          && data.valuePercent <= 100
          && data.testDate is timestamp
          && data.note is string
          && data.note.size() <= 1000
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /users/{userId}/glucose_readings/{readingId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && isValidReading()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
          && isValidReading()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/hba1c_results/{resultId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && isValidHba1cResult()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
          && isValidHba1cResult()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    function isValidReminder() {
      let data = request.resource.data;

      return data.keys().hasAll([
            'type',
            'hour',
            'minute',
            'weekdays',
            'note',
            'isEnabled',
            'createdAt',
            'updatedAt'
          ])
          && data.keys().hasOnly([
            'type',
            'hour',
            'minute',
            'weekdays',
            'note',
            'isEnabled',
            'createdAt',
            'updatedAt'
          ])
          && data.type in ['fasting', 'postMeal', 'insulin']
          && data.hour is int
          && data.hour >= 0
          && data.hour <= 23
          && data.minute is int
          && data.minute >= 0
          && data.minute <= 59
          && data.weekdays is list
          && data.weekdays.size() >= 1
          && data.weekdays.size() <= 7
          && data.weekdays.hasOnly([1, 2, 3, 4, 5, 6, 7])
          && data.weekdays.toSet().size() == data.weekdays.size()
          && data.note is string
          && data.note.size() <= 200
          && data.isEnabled is bool
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    match /users/{userId}/reminders/{reminderId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
          && isValidReminder()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
          && isValidReminder()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }
  }
}